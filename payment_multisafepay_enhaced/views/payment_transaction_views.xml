<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Payment Transaction Form View - MultiSafepay specific fields -->
    <record id="payment_transaction_form_multisafepay" model="ir.ui.view">
        <field name="name">payment.transaction.form.multisafepay</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form" />
        <field name="arch" type="xml">
            <!-- Add refund reason field in the sheet, visible only for MultiSafepay refunds -->
            <xpath expr="//sheet" position="inside">
                <group
                    string="MultiSafepay Refund Information"
                    invisible="provider_code != 'multisafepay' or operation != 'refund'"
                >
                    <field
                        name="multisafepay_refund_reason"
                        placeholder="e.g., Customer requested, Damaged product, etc."
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
