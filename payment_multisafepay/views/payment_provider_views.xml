<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_provider_form_multisafepay" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.multisafepay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group
                    name="multisafepay_credentials"
                    string="MultiSafepay Credentials"
                    invisible="code != 'multisafepay'"
                >
                    <field name="multisafepay_api_key" password="True" />
                </group>
            </xpath>

            <xpath expr="//a[@name='action_view_payment_methods']" position="after">
                <a
                    invisible="code != 'multisafepay' or code == 'multisafepay' and state == 'disabled'"
                    type="object"
                    name="pull_merchant_payment_methods"
                    class="btn btn-link pl-2"
                    role="button"
                >
                    <i class="fa fa-refresh" /> Sync Payment Methods
                </a>
            </xpath>
            <xpath expr="//field[@name='allow_tokenization']" position="attributes">
                <attribute name="readonly">code == 'multisafepay'</attribute>
            </xpath>
            <xpath expr="//field[@name='capture_manually']" position="attributes">
                <attribute name="readonly">code == 'multisafepay'</attribute>
            </xpath>
            <xpath expr="//field[@name='allow_express_checkout']" position="attributes">
                <attribute name="readonly">code == 'multisafepay'</attribute>
            </xpath>
            <xpath expr="//page[@name='configuration']" position="inside">
                <group
                    name="multisafepay_advanced_configuration"
                    string="Advanced"
                    invisible="code != 'multisafepay'"
                >
                    <label for="multisafepay_active_shopping_cart" string="Active Shopping Cart"/>
                    <div class="o_row">
                        <field name="multisafepay_active_shopping_cart" nolabel="1" />
                        <span class="badge text-bg-info ms-2" title="Experimental Feature">BETA</span>
                    </div>
                    <field name="multisafepay_validate_shopping_cart" invisible="not multisafepay_active_shopping_cart" />
                    <div colspan="2" class="alert alert-warning" role="alert" invisible="multisafepay_active_shopping_cart">
                        <strong>Warning:</strong> Without the Shopping Cart enabled, "Pay After Delivery" (BNPL) payment methods cannot be used. Some standard Odoo scenarios might not be fully supported.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
