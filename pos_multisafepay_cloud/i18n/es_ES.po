msgstr "Clave API utilizada para el Terminal Group ID configurado."

#. module: pos_multisafepay_cloud
#: model:ir.model.fields,help:pos_multisafepay_cloud.field_pos_payment_method__msp_cloud_validate_cart
msgid ""
"Ask MultiSafepay to validate the shopping cart total against the payment "
"amount. Enable this only when Cloud POS payments always cover the full POS "
"order amount."
msgstr ""
"Solicitar a MultiSafepay que valide el total del carrito de compras contra "
"el importe del pago. Active esto solo cuando los pagos de Cloud POS cubran "
"siempre el importe total del pedido del punto de venta."

