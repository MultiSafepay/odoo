#. module: pos_multisafepay_cloud
#. odoo-python
#: code:addons/pos_multisafepay_cloud/models/pos_payment_method.py:0
msgid ""
"Terminal ID '%(terminal_id)s' with Terminal Group ID '%(terminal_group_id)s'"
" is already configured on payment method '%(payment_method_name)s'. Use one "
"payment method per terminal configuration."
msgstr ""
"Terminal ID '%(terminal_id)s' mit Terminal Group ID '%(terminal_group_id)s' "
"ist bereits auf der Zahlungsmethode '%(payment_method_name)s' konfiguriert. "
"Verwenden Sie eine Zahlungsmethode pro Terminal-Konfiguration."

#. module: pos_multisafepay_cloud
#: model:ir.model.fields,help:pos_multisafepay_cloud.field_pos_payment_method__msp_cloud_terminal_group_id
msgid ""
"Terminal group identifier used by the Cloud POS API auth scope. Use a "
"dedicated payment method per terminal configuration."
msgstr ""
"Terminal Group-Kennung, die vom Cloud POS API auth scope verwendet wird. "
"Verwenden Sie eine dedizierte Zahlungsmethode pro Terminal-Konfiguration."

#. module: pos_multisafepay_cloud
#. odoo-python
#: code:addons/pos_multisafepay_cloud/controllers/main.py:0
msgid "The MultiSafepay Cloud POS notification signature is invalid."
msgstr "Die MultiSafepay Cloud POS-Benachrichtigungssignatur ist ungültig."

#. module: pos_multisafepay_cloud
#. odoo-python
#: code:addons/pos_multisafepay_cloud/helpers/error_payload.py:0
msgid ""
"The MultiSafepay Cloud POS payment could not be cancelled because the "
"terminal transaction is no longer available. It may already be cancelled or "
"expired."
msgstr ""
"Die MultiSafepay Cloud POS-Zahlung konnte nicht abgebrochen werden, da die "
"Terminal-Transaktion nicht mehr verfügbar ist. Sie ist möglicherweise "
"bereits abgebrochen oder abgelaufen."

#. module: pos_multisafepay_cloud
#. odoo-python
#: code:addons/pos_multisafepay_cloud/models/pos_multisafepay_cloud_payment.py:0
msgid ""
"The MultiSafepay Cloud POS payment is already paid and cannot be cancelled."
msgstr ""
"Die MultiSafepay Cloud POS-Zahlung ist bereits bezahlt und kann nicht "
"abgebrochen werden."

#. module: pos_multisafepay_cloud
#. odoo-python
#: code:addons/pos_multisafepay_cloud/helpers/error_payload.py:0
msgid ""
"The MultiSafepay Cloud POS payment is no longer available as an active "
"terminal transaction. It may have timed out or been cancelled on the "
"terminal. Check the terminal before retrying."
msgstr ""
"Die MultiSafepay Cloud POS-Zahlung ist nicht mehr als aktive Terminal-"
"Transaktion verfügbar. Sie ist möglicherweise abgelaufen oder auf dem "
"Terminal abgebrochen. Überprüfen Sie das Terminal vor dem Wiederholen."

#. module: pos_multisafepay_cloud
#. odoo-python
#: code:addons/pos_multisafepay_cloud/models/pos_payment_method.py:0
msgid "The MultiSafepay Cloud POS refund amount must be greater than zero."
msgstr ""
"Der MultiSafepay Cloud POS-Rückerstattungsbetrag muss größer als Null sein."

#. module: pos_multisafepay_cloud
#. odoo-python
#: code:addons/pos_multisafepay_cloud/helpers/error_payload.py:0
msgid ""
"The MultiSafepay Cloud POS terminal did not return a final result in time. "
"Check the terminal status before retrying the payment."
msgstr ""
"Das MultiSafepay Cloud POS-Terminal hat nicht rechtzeitig ein Endergebnis "
"zurückgegeben. Überprüfen Sie den Terminal-Status vor dem Erneuten Versuch "
"der Zahlung."

#. module: pos_multisafepay_cloud
#. odoo-python
#: code:addons/pos_multisafepay_cloud/models/pos_multisafepay_cloud_payment.py:0
msgid "The original MultiSafepay Cloud POS payment is already fully refunded."
msgstr ""
"Die ursprüngliche MultiSafepay Cloud POS-Zahlung wurde bereits vollständig "
"erstattet."

#. module: pos_multisafepay_cloud
