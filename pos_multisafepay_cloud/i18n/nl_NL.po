#. module: pos_multisafepay_cloud
#: model_terms:ir.ui.view,arch_db:pos_multisafepay_cloud.view_pos_payment_method_form_multisafepay_cloud
msgid ""
"<i class=\"fa fa-exclamation-triangle me-2\"/>\n"
"                        <strong>Cloud POS reference strategy.</strong>\n"
"                        Cloud POS uses the POS receipt reference as the remote order ID and suffixes retries as reference-1, reference-2, etc."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-2\"/>\n"
"                        <strong>Cloud POS-referentiestrategie.</strong>\n"
"                        Cloud POS gebruikt de bonreferentie van de POS als externe order-ID en voegt herhalingen toe als referentie-1, referentie-2, enz."

#. module: pos_multisafepay_cloud
#. odoo-python
#: code:addons/pos_multisafepay_cloud/helpers/notification_payload.py:0
msgid ""
"A terminal-side tip was detected in MultiSafepay. Tips must be added in Odoo"
" so the POS order, shopping cart and accounting stay aligned."
msgstr ""
"Een fooi van de terminal is gedetecteerd in MultiSafepay. Fooien moeten in "
"Odoo worden toegevoegd zodat de POS-order, winkelwagen en boekhouding "
"gesynchroniseerd blijven."

